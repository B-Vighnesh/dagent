# Copy this file to .env and add your own Groq API key if review is needed.
# Leave GROQ_API_KEY empty to disable Groq review.
GROQ_API_KEY=

GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=8
DEVICE=cpu
BINARY_THRESHOLD=0.5
CATEGORY_THRESHOLD=0.0
MAX_SEQ_LENGTH=128
ALLOWED_ORIGINS=*
# Set only if you intentionally want rejected page text saved locally.
# REJECTED_LOG_PATH=./data/rejected_detections.jsonl
# STAGE1_MODEL_DIR=./models/dark_pattern_stage1_binary
# STAGE2_MODEL_DIR=./models/dark_pattern_stage2_category
