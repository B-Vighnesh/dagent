{
  "manifest_version": 3,
  "name": "DarkPatternGuard (offline)",
  "version": "1.0",
  "description": "Detect dark patterns offline using ONNX runtime in the extension.",
  "permissions": ["storage", "scripting", "activeTab", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DarkPatternGuard"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
